# The static site: `just build` writes serve/, the tree that piabrota.art serves: the home
# (serve/index.html) and alerts (serve/alerts/).
set shell := ["bash", "-euo", "pipefail", "-c"]
out := "serve/alerts"

default:
    @just --list

# The page, its style, the drawings and the code graph.
build:
    rm -rf serve && mkdir -p {{out}}
    gleam run --no-print-progress -m home > serve/index.html
    gleam run --no-print-progress > {{out}}/index.html
    grep -qF '<h1>alerts</h1>' {{out}}/index.html
    cp static/style.css ../docs/drawings/wave.svg ../docs/img/fluxo-alerta.png {{out}}/
    code-graph extract .. --out {{out}}/grafo --exclude vendor --exclude target --exclude build --exclude site --exclude scripts --exclude verbs --title smart-alerts
    test -s {{out}}/grafo/graph.html
    @echo "site: {{out}}/index.html"
