# Copy this file to .env and fill in the values. Git ignores .env: never commit a webhook URL,
# because it holds the webhook token. `just` and the `alerts` binary read .env; a variable that is
# already set in the shell wins, and an empty value counts as not set. See docs/DISCORD.md.

# The Discord webhook for `just test-message`, `just mock-alerts` and `alerts poll`.
DISCORD_WEBHOOK_URL=

# The webhook of the official Marola Discord, for `just marola-discord` (part of `just check`).
MAROLA_DISCORD_WEBHOOK_URL=

# The sources that `alerts poll` (and `just poll`) reads, for example: cemaden
ALERTS_SOURCES=

# The states that `alerts poll` delivers: all, or for example PR,SC,RS (the default).
ALERTS_UFS=

# BYOT: your own tokens for the catalog sources that need one (`alerts sources` says how to get
# each one, `alerts tokens` says which are set). Never commit a token.
ALERTS_TOKEN_CEMADEN_PED=
ALERTS_TOKEN_INMET_ESTACOES=
ALERTS_TOKEN_ANA=
ALERTS_TOKEN_METEO_FRANCE=
ALERTS_TOKEN_AEMET=

# Optional: an Atom + CAP 1.2 feed file, its id, the database, and a mock alerts file.
FEED_PATH=
FEED_ID=
ALERTS_DB=
MOCK_ALERTS_PATH=
